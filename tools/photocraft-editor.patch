+
+fn save_to_host(bytes: &[u8]) {
+    let Some(window) = web_sys::window() else { return };
+    let Ok(host) = js_sys::Reflect::get(&window, &"photocraftHost".into()) else { return };
+    if host.is_undefined() || host.is_null() {
+        return;
+    }
+    let Ok(saved) = js_sys::Reflect::get(&host, &"saved".into()) else { return };
+    let Some(saved) = saved.dyn_ref::<js_sys::Function>() else { return };
+    let data = js_sys::Uint8Array::from(bytes);
+    let _ = saved.call1(&host, &data);
+}
