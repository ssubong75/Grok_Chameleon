+fn session_file_name(bytes: &[u8]) -> String {
+    let text = String::from_utf8_lossy(bytes);
+    let Some(at) = text.find("\"file\"") else { return "source.png".into() };
+    let rest = &text[at + 6..];
+    let Some(q1) = rest.find('"') else { return "source.png".into() };
+    let rest = &rest[q1 + 1..];
+    let Some(q2) = rest.find('"') else { return "source.png".into() };
+    let name = &rest[..q2];
+    if name.is_empty() { "source.png".into() } else { name.to_string() }
